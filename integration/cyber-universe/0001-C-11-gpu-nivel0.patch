C-11: comanda `gpu` (nivel 0 = identificare GA104, doar citire)

NU este aplicat in cyber-universe. Se aplica manual, dupa revizuire:
  cp <cyber-gpu>/integration/cyber-universe/kernel/src/drivers/gpu.rs kernel/src/drivers/gpu.rs
  git apply <cyber-gpu>/integration/cyber-universe/0001-C-11-gpu-nivel0.patch

--- a/kernel/Cargo.toml
+++ b/kernel/Cargo.toml
@@ -11,5 +11,9 @@
 cyber_crypto = { path = "../crypto" }
 # P6-01: Realtek RTL8168/8111 driver logic (tested on the host against a model of the chip).
 cyber_rtl8168 = { path = "../rtl8168" }
+# C-11: compute GPU backend (github.com/Adriancu91/cyber-gpu), level 0 = read-only identification.
+gpu-core = { git = "https://github.com/Adriancu91/cyber-gpu", rev = "dda59f92cd6d657b5e93b9cebd8a9f6d9ba9f988" }
+gpu-pci = { git = "https://github.com/Adriancu91/cyber-gpu", rev = "dda59f92cd6d657b5e93b9cebd8a9f6d9ba9f988" }
+nvidia-ga104 = { git = "https://github.com/Adriancu91/cyber-gpu", rev = "dda59f92cd6d657b5e93b9cebd8a9f6d9ba9f988" }

