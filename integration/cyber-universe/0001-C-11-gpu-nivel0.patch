+fn gpu(args: &[&str]) {
+    match args {
+        [] | ["identifica"] => out!("{}", crate::drivers::gpu::identify()),
+        ["plan"] => out!("{}", crate::drivers::gpu::plan()),
+        ["dimensiuni", "da"] => out!("{}", crate::drivers::gpu::size()),
+        _ => {
+            out!("folosire: gpu [identifica|plan|dimensiuni da]\n");
+            out!("  identifica      nivel 0: PCI + NV_PMC_BOOT_0/BOOT_42, doar citire (implicit)\n");
+            out!("  plan            pasii de initializare GA104 si unde se opresc\n");
+            out!("  dimensiuni da   marimea BAR-urilor: scrie in configuratia PCI cu decodarea oprita\n");
+        }
+    }
+}
