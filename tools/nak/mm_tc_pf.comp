// C-157 p.2 after os-423 (session 229): mm_tc with the global loads issued AHEAD ("citirile in avans").
// os-423: mm_tc was right bit for bit on the board but slow (1.03 TFLOP/s): the NAK listing shows that each of its 96
// global loads is waited on before the next one is issued (the `if (inside)` around every load makes a branch per
// load), so at most 1 load is in flight per thread (tools/nak/citiri_seriale.py, T234).
// The cure, the same idea as attention gen 3 (which passed on the board): every thread reads its 16 elements of op(A)
// and 16 of op(B) for a K-slice into REGISTERS with no branch (the index is clamped to element 0 when it falls outside
// the matrix, the value is replaced by 0 afterwards with a select), and it reads the NEXT slice into those registers
// while the tensor cores work on the current one (one slice ahead, register double buffering).
// The arithmetic is UNCHANGED: the same f16 rounding of the same values (0 outside the matrices), the same 64x64
// tiles, 128 threads, the same coopMatMulAdd chain with K in steps of 16 in order, the same store and the same single
// f32 add of bias[col]. So C is the same bits as mm_tc (judged in SIMULARE, T235); only the timing may change.
// Compiled with the SECOND NAK tool (tools/nak/build2.sh, Mesa 26.3.1). Nothing here has run on a board.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#define BM 64u
#define BN 64u
#define BK 32u
#define THREADS 128u
#define TA 1u
#define TB 2u
#define BIAS 4u

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer In { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Out { float v[]; };

layout(push_constant) uniform Args {
    In a;
    In b;
    Out c;
    In bias;
    uint m;
    uint n;
    uint k;
    uint flags;
} args;

shared float16_t as_[BM * BK];  // op(A) slice, row-major [r][p], stride BK
shared float16_t bs_[BK * BN];  // op(B) slice, row-major [p][col], stride BN
shared float cs_[BM * BN];      // the finished 64x64 block, row-major, stride BN

// Reads the K-slice starting at t: element s of ra / rb is the value this thread stores at (tid + s * 128) of the
// slice, exactly as in mm_tc. NO BRANCH anywhere between the loads: NAK waits for every load in flight at a branch
// (first build of this program, session 229: a `?:` and an `&&` per load were enough to keep 1 load in flight), so
// the storage-order choices are selects (mix with a bool), the inside test is a 0/1 integer (bitwise and of two
// comparisons) kept as one bit of a mask (16 live bools would need predicates, which NAK has only 7 of: the second
// build used them right after each load), outside the matrix the index is multiplied by 0 (element 0, always valid:
// m, n, k >= 1); the value read there is replaced by 0 only when it is stored to shared memory (the third build
// chose the zero right after each load in the read before the loop, which made the loads wait again). Called with t >= k too (the read after the last slice): then every element is outside, all reads go to
// element 0 and give 0, never used.
void load_slice(uint t, uint row0, uint col0, uint tid, bool ta, bool tb,
                out float ra[(BM * BK) / THREADS], out float rb[(BK * BN) / THREADS], out uint ia, out uint ib) {
    ia = 0u;  // bit s: element s of the A part is inside (a mask in one register, not 16 predicates)
    ib = 0u;  // the same for the B part
    for (uint s = 0u; s < (BM * BK) / THREADS; s++) {
        uint e = tid + s * THREADS;
        uint r = mix(e / BK, e % BM, ta);
        uint p = mix(e % BK, e / BM, ta);
        uint gr = row0 + r;
        uint gp = t + p;
        uint in_ = uint(gr < args.m) & uint(gp < args.k);
        ia |= in_ << s;
        uint at = mix(gr * args.k + gp, gp * args.m + gr, ta);
        ra[s] = args.a.v[at * in_];
    }
    for (uint s = 0u; s < (BK * BN) / THREADS; s++) {
        uint e = tid + s * THREADS;
        uint p = mix(e / BN, e % BK, tb);
        uint cl = mix(e % BN, e / BK, tb);
        uint gp = t + p;
        uint gc = col0 + cl;
        uint in_ = uint(gp < args.k) & uint(gc < args.n);
        ib |= in_ << s;
        uint at = mix(gp * args.n + gc, gc * args.k + gp, tb);
        rb[s] = args.b.v[at * in_];
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint w = tid / 32u;
    uint wr = (w / 2u) * 32u;
    uint wc = (w % 2u) * 32u;
    uint row0 = gl_WorkGroupID.y * BM;
    uint col0 = gl_WorkGroupID.x * BN;
    bool ta = (args.flags & TA) != 0u;
    bool tb = (args.flags & TB) != 0u;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[2][2];
    for (uint i = 0u; i < 2u; i++) {
        for (uint j = 0u; j < 2u; j++) {
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        }
    }

    // The 16 + 16 values of the current slice, read ahead into registers, and which of them are inside.
    float ra[(BM * BK) / THREADS];
    float rb[(BK * BN) / THREADS];
    uint ia;
    uint ib;
    load_slice(0u, row0, col0, tid, ta, tb, ra, rb, ia, ib);

    for (uint t = 0u; t < args.k; t += BK) {
        for (uint s = 0u; s < (BM * BK) / THREADS; s++) {
            uint e = tid + s * THREADS;
            uint r = mix(e / BK, e % BM, ta);
            uint p = mix(e % BK, e / BM, ta);
            as_[r * BK + p] = float16_t(mix(0.0, ra[s], ((ia >> s) & 1u) != 0u));
        }
        for (uint s = 0u; s < (BK * BN) / THREADS; s++) {
            uint e = tid + s * THREADS;
            uint p = mix(e / BN, e % BK, tb);
            uint cl = mix(e % BN, e / BK, tb);
            bs_[p * BN + cl] = float16_t(mix(0.0, rb[s], ((ib >> s) & 1u) != 0u));
        }
        barrier();
        // The next slice's loads go out now and land while the tensor cores work on this one. No `if (t + BK < k)`:
        // a branch here would make NAK wait for them before the tensor cores start; after the last slice the reads
        // are all outside (element 0, value 0) and are not used.
        load_slice(t + BK, row0, col0, tid, ta, tb, ra, rb, ia, ib);
        for (uint kk = 0u; kk < BK; kk += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa[2];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb[2];
            for (uint i = 0u; i < 2u; i++) {
                coopMatLoad(fa[i], as_, (wr + 16u * i) * BK + kk, BK, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint j = 0u; j < 2u; j++) {
                coopMatLoad(fb[j], bs_, kk * BN + wc + 16u * j, BN, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint i = 0u; i < 2u; i++) {
                for (uint j = 0u; j < 2u; j++) {
                    acc[i][j] = coopMatMulAdd(fa[i], fb[j], acc[i][j]);
                }
            }
        }
        barrier();
    }

    for (uint i = 0u; i < 2u; i++) {
        for (uint j = 0u; j < 2u; j++) {
            coopMatStore(acc[i][j], cs_, (wr + 16u * i) * BN + wc + 16u * j, BN, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
    barrier();
    for (uint s = 0u; s < (BM * BN) / THREADS; s++) {
        uint e = tid + s * THREADS;
        uint r = e / BN;
        uint cl = e % BN;
        uint gr = row0 + r;
        uint gc = col0 + cl;
        if (gr < args.m && gc < args.n) {
            float v = cs_[e];
            if ((args.flags & BIAS) != 0u) {
                v += args.bias.v[gc];
            }
            args.c.v[gr * args.n + gc] = v;
        }
    }
}
