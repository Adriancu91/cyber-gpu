// Matmul step 4 (siboehm SGEMM_CUDA kernel 4 "1D blocktiling", MIT, idea only): C[M,N] = A[M,K] * B[K,N],
// row-major f32. One workgroup = 512 threads computes a 64x64 block of C; each thread computes TM = 8 results
// in one column (rows threadRow*8 .. threadRow*8+7 of the block), keeping them in 8 registers.
// Per K-tile of BK = 8: every thread loads one element of the 64x8 tile of A and one of the 8x64 tile of B into
// shared memory (4 KiB in total), barrier, then for p in the tile: one B value from shared memory is reused for
// the 8 accumulators. The inner loop stops at K exactly (no zero padding is accumulated), so each element of C
// is still the same chain of fused multiply-adds in the order p = 0..K-1 as steps 1-3: the oracle stays
// gpu-compute::reference::matmul_fma_ftz, bit for bit. Threads outside C still load (zeros) and wait at the
// barriers; they only skip the stores.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define BM 64u
#define BN 64u
#define BK 8u
#define TM 8u

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer In { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Out { float v[]; };

layout(push_constant) uniform Args {
    In a;
    In b;
    Out c;
    uint m;
    uint n;
    uint k;
} args;

shared float as_[BM * BK];
shared float bs_[BK * BN];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint thread_col = tid % BN;
    uint thread_row = tid / BN;           // 0..7
    uint row0 = gl_WorkGroupID.y * BM;    // first row of the block
    uint col = gl_WorkGroupID.x * BN + thread_col;
    uint a_row = tid / BK, a_col = tid % BK;   // the element of the A tile this thread loads
    uint b_row = tid / BN, b_col = tid % BN;   // the element of the B tile this thread loads
    float acc[TM];
    for (uint i = 0; i < TM; i++) acc[i] = 0.0;
    for (uint t = 0; t < args.k; t += BK) {
        uint ar = row0 + a_row, ak = t + a_col;
        as_[a_row * BK + a_col] = (ar < args.m && ak < args.k) ? args.a.v[ar * args.k + ak] : 0.0;
        uint bk = t + b_row, bc = gl_WorkGroupID.x * BN + b_col;
        bs_[b_row * BN + b_col] = (bk < args.k && bc < args.n) ? args.b.v[bk * args.n + bc] : 0.0;
        barrier();
        uint len = min(BK, args.k - t);
        for (uint p = 0; p < len; p++) {
            float bv = bs_[p * BN + thread_col];
            for (uint i = 0; i < TM; i++) {
                acc[i] += as_[(thread_row * TM + i) * BK + p] * bv;
            }
        }
        barrier();
    }
    for (uint i = 0; i < TM; i++) {
        uint row = row0 + thread_row * TM + i;
        if (row < args.m && col < args.n) {
            args.c.v[row * args.n + col] = acc[i];
        }
    }
}
