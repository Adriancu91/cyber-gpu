// C-165 race variant of mm_train_tile (docs/C-165_CURSA_MM.md): BM x BN = 128 x 64 block of C, BK = 16, TM x TN = 8 x 4
// per thread. Same job, push constants and bits as mm_train; the body is mm_train_tv.glsl.
#version 460
#extension GL_GOOGLE_include_directive : require
#define BM 128u
#define BN 64u
#define BK 16u
#define TM 8u
#define TN 4u
#include "mm_train_tv.glsl"
